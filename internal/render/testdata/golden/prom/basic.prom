copyfail_validator_check_state{check_id="afalg.procscan",severity="advisory",state="fail"} 0
copyfail_validator_check_state{check_id="afalg.procscan",severity="advisory",state="skip"} 1
copyfail_validator_check_state{check_id="afalg.procscan",severity="advisory",state="error"} 0
copyfail_validator_check_state{check_id="integrity.copyfail_pkg",severity="required",state="pass"} 0
copyfail_validator_check_state{check_id="integrity.copyfail_pkg",severity="required",state="fail"} 0
copyfail_validator_check_state{check_id="integrity.copyfail_pkg",severity="required",state="skip"} 0
copyfail_validator_check_state{check_id="integrity.copyfail_pkg",severity="required",state="error"} 1
copyfail_validator_check_state{check_id="kernel.modules_loaded",severity="required",state="pass"} 0
copyfail_validator_check_state{check_id="kernel.modules_loaded",severity="required",state="fail"} 1
copyfail_validator_check_state{check_id="kernel.modules_loaded",severity="required",state="skip"} 0
copyfail_validator_check_state{check_id="kernel.modules_loaded",severity="required",state="error"} 0
